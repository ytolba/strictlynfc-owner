{
  "expo": {
    "name": "StrictlyVision",
    "slug": "strictlyvision",
    "version": "1.0.0",
    "description": "Tap connected gym equipment, learn each movement, log workouts, track progress, and manage a smarter gym floor.",
    "orientation": "portrait",
    "scheme": "strictlyvision",
    "icon": "./assets/strictlyvision-app-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.strictlyinc.strictlyvision",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:strictlyinc.com"
      ],
      "infoPlist": {
        "NFCReaderUsageDescription": "StrictlyVision uses NFC to open connected gym equipment and to program tags for approved gym owners."
      },
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": [
          "NDEF"
        ]
      },
      "appleTeamId": "67A2H77882"
    },
    "android": {
      "package": "com.strictlyinc.strictlyvision",
      "permissions": [
        "android.permission.NFC",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.WRITE_EXERCISE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/strictlyvision-adaptive-foreground.png",
        "backgroundColor": "#08090A"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "strictlyinc.com",
              "pathPrefix": "/t/"
            },
            {
              "scheme": "https",
              "host": "strictlyinc.com",
              "pathPrefix": "/vaultclub/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "StrictlyVision uses NFC to open connected gym equipment and program tags for approved gym owners."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/strictlyvision-mark-transparent.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#08090A",
          "dark": {
            "image": "./assets/strictlyvision-mark-transparent.png",
            "backgroundColor": "#08090A"
          }
        }
      ],
      "./plugins/withOptionalNfc",
      "expo-apple-authentication",
      "expo-video",
      "expo-web-browser",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "StrictlyVision reads workout time, heart rate, and active energy from Apple Health to attach those values to completed workouts in your StrictlyVision history.",
          "NSHealthUpdateUsageDescription": "StrictlyVision writes a completed strength workout and its duration to Apple Health only after you finish a workout with Health sync enabled.",
          "background": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "StrictlyVision uses your location only while the app is open to show the partner gym closest to you.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "https://owedpojalgtkiuthptft.supabase.co",
      "supabasePublishableKey": "sb_publishable_7FLJBomC7TcEGCbTMPPn8Q_U0aj_zVG",
      "ownerApiUrl": "https://strictlyinc.com",
      "eas": {
        "projectId": "144cd34f-9ee8-4756-86e2-842c4a39cce1"
      }
    },
    "owner": "yaseentolba"
  }
}
