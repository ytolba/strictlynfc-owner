{
  "expo": {
    "name": "StrictlyVision",
    "slug": "strictlyvision",
    "version": "1.0.0",
    "description": "Tap connected gym equipment, learn each movement, log workouts, track progress, and manage a smarter gym floor.",
    "orientation": "portrait",
    "scheme": "strictlyvision",
    "icon": "./assets/strictlyvision-app-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.strictlyinc.strictlyvision",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:strictlyinc.com"
      ],
      "infoPlist": {
        "NFCReaderUsageDescription": "StrictlyVision uses NFC to open connected gym equipment and to program tags for approved gym owners."
      },
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": [
          "NDEF"
        ]
      },
      "appleTeamId": "67A2H77882"
    },
    "android": {
      "package": "com.strictlyinc.strictlyvision",
      "permissions": [
        "android.permission.NFC"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/strictlyvision-app-icon.png",
        "backgroundColor": "#08090A"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "strictlyinc.com",
              "pathPrefix": "/t/"
            },
            {
              "scheme": "https",
              "host": "strictlyinc.com",
              "pathPrefix": "/vaultclub/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "StrictlyVision uses NFC to open connected gym equipment and program tags for approved gym owners."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/strictlyvision-mark-transparent.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#08090A",
          "dark": {
            "image": "./assets/strictlyvision-mark-transparent.png",
            "backgroundColor": "#08090A"
          }
        }
      ],
      "./plugins/withOptionalNfc",
      "expo-apple-authentication",
      "expo-video",
      "expo-web-browser",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "StrictlyVision reads your workouts so your gym sessions and Apple Health stay in sync.",
          "NSHealthUpdateUsageDescription": "StrictlyVision saves your finished gym workouts, including duration, to Apple Health.",
          "background": false
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "StrictlyVision uses your location to show the partner gym closest to you."
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "https://owedpojalgtkiuthptft.supabase.co",
      "supabasePublishableKey": "sb_publishable_7FLJBomC7TcEGCbTMPPn8Q_U0aj_zVG",
      "ownerApiUrl": "https://strictlyinc.com"
    }
  }
}
